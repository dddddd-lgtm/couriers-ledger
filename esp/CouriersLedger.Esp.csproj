<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds CouriersLedger.esp: a light (ESL-flagged) plugin with one quest, the tracking marker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.*" />
  </ItemGroup>
</Project>
